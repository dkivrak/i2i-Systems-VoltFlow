{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltflow.local/contracts/asset-registration-event.schema.json",
  "title": "Asset registration event",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/eventMetadata" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventVersion",
        "eventType",
        "occurredAt",
        "homeId",
        "homeName",
        "appliances"
      ],
      "properties": {
        "eventId": { "$ref": "common.schema.json#/$defs/uuid" },
        "eventVersion": { "const": 1 },
        "eventType": { "const": "HOME_REGISTERED" },
        "occurredAt": { "$ref": "common.schema.json#/$defs/utcInstant" },
        "homeId": { "$ref": "common.schema.json#/$defs/positiveId" },
        "homeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "appliances": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/registeredAppliance" }
        }
      }
    }
  ]
}
