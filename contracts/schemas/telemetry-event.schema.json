{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voltwise.local/contracts/telemetry-event.schema.json",
  "title": "Appliance telemetry event",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/eventMetadata" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventVersion",
        "eventType",
        "occurredAt",
        "homeId",
        "applianceId",
        "applianceType",
        "powerWatts",
        "operatingState"
      ],
      "properties": {
        "eventId": { "$ref": "common.schema.json#/$defs/uuid" },
        "eventVersion": { "const": 1 },
        "eventType": { "const": "APPLIANCE_TELEMETRY_RECORDED" },
        "occurredAt": { "$ref": "common.schema.json#/$defs/utcInstant" },
        "homeId": { "$ref": "common.schema.json#/$defs/positiveId" },
        "applianceId": { "$ref": "common.schema.json#/$defs/positiveId" },
        "applianceType": { "$ref": "common.schema.json#/$defs/applianceType" },
        "powerWatts": { "$ref": "common.schema.json#/$defs/nonNegativeDecimal" },
        "operatingState": { "$ref": "common.schema.json#/$defs/operatingState" }
      }
    }
  ]
}
