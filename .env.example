# PostgreSQL
POSTGRES_DB=voltwise
POSTGRES_USER=voltwise
POSTGRES_PASSWORD=change-me-for-non-local-use
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/voltwise

# Authentication. Replace with a long random value outside local development.
JWT_SECRET=change-this-local-jwt-secret-with-at-least-32-characters
JWT_EXPIRATION_SECONDS=86400

# Kafka and Ignite addresses used inside Docker Compose
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
IGNITE_ADDRESSES=ignite:10800
REGISTRATION_OUTBOX_RETRY_INTERVAL_MS=5000
REGISTRATION_OUTBOX_STARTUP_DELAY_MS=1000
REGISTRATION_OUTBOX_BATCH_SIZE=50
REGISTRATION_OUTBOX_ACK_TIMEOUT_MS=35000
REGISTRATION_OUTBOX_INITIAL_BACKOFF_MS=2000
REGISTRATION_OUTBOX_MAX_BACKOFF_MS=60000

# Optional Google Gemini integration. Leave blank to exercise the Turkish fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CONNECT_TIMEOUT_MS=3000
GEMINI_READ_TIMEOUT_MS=7000

# Simulation and persistence cadence
TELEMETRY_INTERVAL_MS=1000
SNAPSHOT_INTERVAL_MS=60000
SIMULATION_RANDOM_SEED=20260721
SIMULATION_ANOMALY_PROBABILITY=0.02
SIMULATION_ANOMALY_DEMO_ENABLED=false
SIMULATION_ANOMALY_DEMO_APPLIANCE_IDS=

# Registration defaults (a request can override these values per home)
DEFAULT_MONTHLY_BUDGET=1000.00
NORMAL_TARIFF_PER_KWH=2.50
PENALTY_TARIFF_MULTIPLIER=1.50

# Browser requests use the frontend reverse proxy by default.
VITE_API_BASE_URL=/api/v1

# Host ports may be changed when a local service already uses a default.
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9092
IGNITE_HOST_PORT=10800
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
